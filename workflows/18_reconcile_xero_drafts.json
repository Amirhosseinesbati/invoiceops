    {
      "id": "623fcec2-7a5a-5bf6-ab4f-6d5ec6665dec",
      "name": "Look Up Xero Invoice Number",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -40,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.xero.com/api.xro/2.0/Invoices",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "xeroOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "xero-tenant-id",
              "value": "={{ $env.XERO_TENANT_ID }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "InvoiceNumbers",
              "value": "={{ $('Read Xero Reconcile Context').item.json.invoice_number }}"
            },
            {
              "name": "ContactIDs",
              "value": "={{ $('Read Xero Reconcile Context').item.json.contact_id }}"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "5abc4496-b381-59f6-bfc1-c775a52b4c71",
      "name": "Classify Xero Lookup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const context = $('Read Xero Reconcile Context').item.json;\nconst response = $input.item.json;\nconst invoices = response.body?.Invoices;\nif (response.statusCode !== 200 || !Array.isArray(invoices) ||\n    Number(response.body?.pagination?.pageCount || 1) > 1) {\n  return {json: {...context, lookup: 'error', reason: 'xero_lookup_incomplete'}};\n}\nconst matches = invoices.filter(bill => bill.Type === 'ACCPAY' &&\n  bill.InvoiceNumber === context.invoice_number &&\n  bill.Contact?.ContactID === context.contact_id);\nif (matches.length === 0 && invoices.length === 0) {\n  return {json: {...context, lookup: 'absent'}};\n}\nif (matches.length !== 1 || invoices.length !== 1) {\n  return {json: {...context, lookup: 'error', reason: 'xero_lookup_ambiguous'}};\n}\nreturn {json: {...context, lookup: 'present', invoice: matches[0]}};"
      }
    },
