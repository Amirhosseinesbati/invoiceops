{
  "id": "364e5c32cef65a73",
  "name": "InvoiceOps | Xero Draft Post",
  "nodes": [
    {
      "id": "aaddde65-15a4-53c7-bd9a-2dc9c2d1f8ff",
      "name": "Xero posting note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -800,
        -320
      ],
      "parameters": {
        "content": "## Connected Xero draft\nConfigure a customer-owned Xero OAuth2 credential and tenant ID before use. Keep this workflow unpublished in DEMO. Xero idempotency keys expire after six minutes, so uncertain outcomes require GET reconciliation before retry.",
        "height": 190,
        "width": 480
      }
    },
    {
      "id": "71a200f1-4641-53b9-9294-23aa84e6363e",
      "name": "When Xero Draft Claimed",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -760,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "16e5c522-3fa8-5b35-831f-59358149cf68",
      "name": "Create Xero Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -520,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.xero.com/api.xro/2.0/Invoices",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "xeroOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "xero-tenant-id",
              "value": "={{ $env.XERO_TENANT_ID }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $('When Xero Draft Claimed').item.json.operation_key }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {Invoices: [{...$('When Xero Draft Claimed').item.json.bill_payload, Type: 'ACCPAY', Status: 'DRAFT'}]} }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "7b3f8133-57e8-5fae-b47f-49fc2880b849",
      "name": "Xero Draft Accepted?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -280,
        -80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c83ecb67-6e34-51d3-9d01-526d844747c2",
              "leftValue": "={{ $json.statusCode >= 200 && $json.statusCode < 300 && !!$json.body?.Invoices?.[0]?.InvoiceID }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
