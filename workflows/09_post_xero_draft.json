        "url": "={{ $env.INVOICEOPS_API_BASE_URL + '/internal/xero/draft-check' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {operation_id: $('When Xero Draft Claimed').item.json.operation_id, attempt: $('When Xero Draft Claimed').item.json.attempt, invoice: $('Create Xero Draft').item.json.body.Invoices[0]} }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "InvoiceOpsInternal",
          "name": "InvoiceOps Internal Header"
        }
      }
    },
