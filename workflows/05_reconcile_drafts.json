        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {workflow_id: String($workflow.id || 'unknown'), execution_id: String($execution.id || 'unknown'), stage: 'reconcile_lookup', message: ('lookup_failed_' + ($json.statusCode || $json.error?.message || 'network')).slice(0, 500)} }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "InvoiceOpsInternal",
          "name": "InvoiceOps Internal Header"
        }
      }
    }
