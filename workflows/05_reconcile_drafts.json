        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {operation_id: $('List Uncertain Operations').item.json.operation_id} }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "InvoiceOpsInternal",
          "name": "InvoiceOps Internal Header"
        }
      }
    },
    {
      "id": "82263504-7393-52ba-b8f3-7e2627516bbc",
