{
  "id": "93d5731cf61652ea",
  "name": "InvoiceOps | Google Drive Intake",
  "nodes": [
    {
      "id": "55a5ac02-535a-5e96-b054-4b611a28f290",
      "name": "Drive intake note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -800,
        -320
      ],
      "parameters": {
        "content": "## Connected folder intake\nUnpublished until a customer-owned Google Drive OAuth credential, folder ID, and workspace ID are configured. Watches new files in the chosen folder, downloads bytes, and reuses the durable intake gate.",
        "height": 190,
        "width": 480
      }
    },
    {
      "id": "9931a8a4-f8a1-5126-9ecf-85466b42cc55",
      "name": "Watch Drive Folder",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        -760,
        0
      ],
      "parameters": {
        "authentication": "oAuth2",
        "triggerOn": "specificFolder",
        "folderToWatch": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_DRIVE_INVOICE_FOLDER_ID }}",
          "mode": "id"
        },
        "event": "fileCreated",
        "options": {}
      }
    },
    {
      "id": "b5d10b5c-1e95-5a9f-9881-e929a186aee7",
      "name": "Download Drive File",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        -520,
        0
      ],
      "parameters": {
        "authentication": "oAuth2",
        "resource": "file",
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $('Watch Drive Folder').item.json.id }}",
          "mode": "id"
        },
        "options": {
          "binaryPropertyName": "data"
        }
      }
    },
    {
      "id": "c9dea500-5649-55cd-ba62-e667154f4515",
      "name": "Encode Drive File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -280,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const source = $('Watch Drive Folder').item.json;\nconst item = $input.item;\nif (!item.binary?.data) throw new Error('drive_file_binary_missing');\nconst data = await this.helpers.getBinaryDataBuffer($itemIndex, 'data');\nif (data.length > 8 * 1024 * 1024) throw new Error('drive_file_exceeds_8mb');\nconst mime = data.subarray(0, 5).toString('ascii') === '%PDF-' ? 'application/pdf'\n  : data[0] === 0x89 && data[1] === 0x50 && data[2] === 0x4e && data[3] === 0x47 ? 'image/png'\n  : data[0] === 0xff && data[1] === 0xd8 && data[2] === 0xff ? 'image/jpeg' : '';\nif (!mime) return {json: {skip: true}};\nconst sourceId = String(source.id || '');\nif (!sourceId) throw new Error('drive_file_identity_missing');\nreturn {json: {event_id: 'drive:' + sourceId, source_system: 'drive', source_id: sourceId,\n  filename: String(source.name || item.binary.data.fileName || 'invoice').slice(0, 160),\n  mime_type: mime, content_base64: data.toString('base64'),\n  received_at: source.createdTime || new Date().toISOString()}};"
      }
    },
    {
      "id": "e905a3b8-af91-50eb-af01-b24354b67a1a",
      "name": "Supported Drive File?",
      "type": "n8n-nodes-base.if",
