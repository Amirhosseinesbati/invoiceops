              "id": "b7fe007b-c6d1-5a82-8ea0-ad93748da92c",
              "leftValue": "={{ !$json.skip }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
