FROM ghcr.io/astral-sh/uv:0.11.28 AS uv
FROM python:3.12.13-slim-bookworm
COPY --from=uv /uv /uvx /bin/
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV PYTHONPATH=/app/apps/api UV_NO_DEV=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
COPY apps/api ./apps/api
COPY scripts ./scripts
COPY migrations ./migrations
COPY alembic.ini ./
EXPOSE 8000
CMD ["sh", "-c", "uv run --frozen alembic upgrade head && uv run --frozen python scripts/seed_demo.py --source-dir /app/generated && uv run --frozen uvicorn invoiceops.main:app --host 0.0.0.0 --port 8000"]
