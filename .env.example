# Copy to .env for local demo. demo-up scripts generate random values for the three secrets.
MODE=DEMO
N8N_HOST_PORT=5678
WEB_HOST_PORT=8080
POSTGRES_PASSWORD=replace-with-random-secret
INTERNAL_TOKEN=replace-with-random-secret
SESSION_SECRET=replace-with-random-secret
N8N_ENCRYPTION_KEY=replace-with-random-secret
DATABASE_URL=postgresql+psycopg://invoiceops:replace-with-random-secret@db:5432/invoiceops
CHECKPOINT_URL=postgresql://invoiceops:replace-with-random-secret@db:5432/invoiceops
DATA_DIR=/app/data
SESSION_COOKIE_SECURE=false
N8N_APPROVAL_WEBHOOK_URL=http://n8n:5678/webhook/invoiceops-approval
N8N_RESOLUTION_WEBHOOK_URL=http://n8n:5678/webhook/invoiceops-resolution
N8N_JOB_COMPLETE_WEBHOOK_URL=http://n8n:5678/webhook/invoiceops-job-complete
N8N_REPLAY_WEBHOOK_URL=http://n8n:5678/webhook/invoiceops-intake
MODEL_ID=
OPENAI_API_KEY=
XERO_CLIENT_ID=
XERO_TENANT_ID=
INVOICEOPS_ACCOUNTING_PROVIDER=demo
INVOICEOPS_CONNECTED_WORKSPACE_ID=
GOOGLE_DRIVE_INVOICE_FOLDER_ID=
REFERENCE_DATE=2026-09-28
